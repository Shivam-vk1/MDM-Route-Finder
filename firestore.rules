rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict Super Admin Gate: Only verified shivamvk1090@gmail.com
    function isAuthorizedAdmin() {
      return isSignedIn() &&
        request.auth.token.email == 'shivamvk1090@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Verified Staff Member Gate: Must be authenticated via Firebase Auth, verified email, and registered in staff_members
    function isAuthorizedStaff() {
      return isSignedIn() &&
        request.auth.token.email_verified == true && (
          (request.auth.token.email != null &&
           exists(/databases/$(database)/documents/staff_members/$(request.auth.token.email)) &&
           get(/databases/$(database)/documents/staff_members/$(request.auth.token.email)).data.active == true &&
           get(/databases/$(database)/documents/staff_members/$(request.auth.token.email)).data.canEdit == true) ||
          (exists(/databases/$(database)/documents/staff_members/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data.active == true &&
           get(/databases/$(database)/documents/staff_members/$(request.auth.uid)).data.canEdit == true)
        );
    }

    function isAuthorizedWriter() {
      return isAuthorizedAdmin() || isAuthorizedStaff();
    }

    // Validation Blueprint for School entity
    function isValidSchool(data) {
      return data.keys().hasAll(['id', 'schoolName', 'routeName', 'lat', 'lon']) &&
        data.keys().hasOnly([
          'id', 'schoolName', 'nodeGroup', 'nodeGroupName', 'udise',
          'routeCode', 'nodeCode', 'routeName', 'lat', 'lon',
          'driverName', 'driverContact', 'routeExecutive', 'routeExecutiveContact',
          'address', 'pincode', 'spocName', 'spocContact', 'category',
          'updatedBy', 'updatedByStaffId', 'updatedAt'
        ]) &&
        data.id is number &&
        data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 200 &&
        data.routeName is string && data.routeName.size() >= 1 && data.routeName.size() <= 100 &&
        data.lat is number && data.lat >= -90 && data.lat <= 90 &&
        data.lon is number && data.lon >= -180 && data.lon <= 180 &&
        (!('nodeGroup' in data) || (data.nodeGroup is string && data.nodeGroup.size() <= 150)) &&
        (!('nodeGroupName' in data) || (data.nodeGroupName is string && data.nodeGroupName.size() <= 200)) &&
        (!('udise' in data) || (data.udise is string && data.udise.size() <= 50)) &&
        (!('routeCode' in data) || (data.routeCode is string && data.routeCode.size() <= 50)) &&
        (!('nodeCode' in data) || (data.nodeCode is string && data.nodeCode.size() <= 50)) &&
        (!('driverName' in data) || (data.driverName is string && data.driverName.size() <= 150)) &&
        (!('driverContact' in data) || (data.driverContact is string && data.driverContact.size() <= 40)) &&
        (!('routeExecutive' in data) || (data.routeExecutive is string && data.routeExecutive.size() <= 150)) &&
        (!('routeExecutiveContact' in data) || (data.routeExecutiveContact is string && data.routeExecutiveContact.size() <= 40)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 350)) &&
        (!('pincode' in data) || (data.pincode is string && data.pincode.size() <= 20)) &&
        (!('spocName' in data) || (data.spocName is string && data.spocName.size() <= 150)) &&
        (!('spocContact' in data) || (data.spocContact is string && data.spocContact.size() <= 40)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
        (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 150)) &&
        (!('updatedByStaffId' in data) || (data.updatedByStaffId is string && data.updatedByStaffId.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Validation Blueprint for RouteConfig entity
    function isValidRouteConfig(data) {
      return data.keys().hasAll(['id', 'routeName', 'color']) &&
        data.keys().hasOnly([
          'id', 'routeName', 'routeCode', 'color',
          'routeExecutive', 'routeExecutiveContact',
          'driverName', 'driverContact',
          'createdAt', 'updatedByStaffId'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 100 &&
        data.routeName is string && data.routeName.size() >= 1 && data.routeName.size() <= 100 &&
        data.color is string && data.color.size() >= 3 && data.color.size() <= 30 &&
        (!('routeCode' in data) || (data.routeCode is string && data.routeCode.size() <= 50)) &&
        (!('routeExecutive' in data) || (data.routeExecutive is string && data.routeExecutive.size() <= 150)) &&
        (!('routeExecutiveContact' in data) || (data.routeExecutiveContact is string && data.routeExecutiveContact.size() <= 40)) &&
        (!('driverName' in data) || (data.driverName is string && data.driverName.size() <= 150)) &&
        (!('driverContact' in data) || (data.driverContact is string && data.driverContact.size() <= 40)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedByStaffId' in data) || (data.updatedByStaffId is string && data.updatedByStaffId.size() <= 100));
    }

    // Validation Blueprint for StaffMember entity (strictly Super Admin managed, no plaintext passwordHint)
    function isValidStaffMember(data) {
      return data.keys().hasAll(['id', 'name', 'loginId', 'role', 'canEdit', 'active']) &&
        data.keys().hasOnly([
          'id', 'name', 'loginId', 'passwordHash',
          'role', 'canEdit', 'active', 'createdAt', 'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 100 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 150 &&
        data.loginId is string && data.loginId.size() >= 1 && data.loginId.size() <= 150 &&
        (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 128)) &&
        data.role is string && data.role.size() >= 1 && data.role.size() <= 100 &&
        data.canEdit is bool &&
        data.active is bool &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 100));
    }

    // Validation Blueprint for AuditLog entity
    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'action', 'summary', 'adminEmail']) &&
        data.keys().hasOnly(['id', 'timestamp', 'action', 'summary', 'adminEmail', 'updatedByStaffId']) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 100 &&
        data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 100 &&
        data.action in [
          'ADD_SCHOOL', 'EDIT_SCHOOL', 'DELETE_SCHOOL',
          'RESET_DATA', 'IMPORT_DATA', 'MANAGE_ROUTE', 'MANAGE_STAFF'
        ] &&
        data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 400 &&
        data.adminEmail is string && data.adminEmail.size() >= 1 && data.adminEmail.size() <= 150 &&
        (!('updatedByStaffId' in data) || (data.updatedByStaffId is string && data.updatedByStaffId.size() <= 100));
    }

    // Connection test document (read-only check)
    match /test/connection {
      allow get: if true;
    }

    // Schools Collection: Publicly readable directory, write operations strictly require verified Firebase Auth
    match /schools/{schoolId} {
      allow get: if isValidId(schoolId);
      allow list: if resource.data.lat >= -90;
      allow create: if isSignedIn() && request.auth.token.email_verified == true && isValidId(schoolId) && isValidSchool(incoming()) && isAuthorizedWriter();
      allow update: if isSignedIn() && request.auth.token.email_verified == true && isValidId(schoolId) && isValidSchool(incoming()) && isAuthorizedWriter();
      allow delete: if isAuthorizedAdmin() && isValidId(schoolId);
    }

    // Routes Collection: Publicly readable route configs, write operations strictly require verified Firebase Auth
    match /routes/{routeId} {
      allow get: if isValidId(routeId);
      allow list: if resource.data.routeName is string;
      allow create: if isSignedIn() && request.auth.token.email_verified == true && isValidId(routeId) && isValidRouteConfig(incoming()) && isAuthorizedWriter();
      allow update: if isSignedIn() && request.auth.token.email_verified == true && isValidId(routeId) && isValidRouteConfig(incoming()) && isAuthorizedWriter();
      allow delete: if isAuthorizedAdmin() && isValidId(routeId);
    }

    // Staff Members Collection: Zero public exposure. Strictly accessible ONLY by Super Admin.
    match /staff_members/{memberId} {
      allow get: if isAuthorizedAdmin() && isValidId(memberId);
      allow list: if isAuthorizedAdmin();
      allow create: if isAuthorizedAdmin() && isValidId(memberId) && isValidStaffMember(incoming());
      allow update: if isAuthorizedAdmin() && isValidId(memberId) && isValidStaffMember(incoming());
      allow delete: if isAuthorizedAdmin() && isValidId(memberId);
    }

    // Audit Logs Collection: Strictly viewable by Super Admin; append-only for verified admin/staff
    match /audit_logs/{logId} {
      allow get: if isAuthorizedAdmin() && isValidId(logId);
      allow list: if isAuthorizedAdmin() && resource.data.id is string;
      allow create: if isSignedIn() && request.auth.token.email_verified == true && isValidId(logId) && isValidAuditLog(incoming()) && isAuthorizedWriter();
      allow update, delete: if false;
    }
  }
}
